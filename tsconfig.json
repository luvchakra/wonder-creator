{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "incremental": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "noUncheckedIndexedAccess": false,
    "types": ["node"],
    // Web tests import app modules by the app's own alias (vitest.config.ts maps it the same way).
    "paths": { "@/*": ["./apps/web/src/*"] }
  },
  "include": ["packages/*/src/**/*.ts", "packages/*/src/**/*.tsx", "tests/**/*.ts", "vitest.config.ts", "playwright.config.ts", "e2e/**/*.ts", "apps/web/src/**/*.test.ts"],
  "exclude": ["node_modules"]
}
