# Copy to apps/web/.env.local. Local values: `npx supabase status -o env`.

# Supabase (public)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Supabase service role — SERVER ONLY (storage registration, intake pipeline, huddle cleanup)
SUPABASE_SECRET_KEY=            # or SUPABASE_SERVICE_ROLE_KEY (legacy name)

# CreatorBrain (server only). Provider: gemini | anthropic | offline (deterministic dev/CI model).
# Without a provider + key: offline dev model in development, "not connected" in production.
WONDERCREATOR_AI_PROVIDER=gemini
WONDERCREATOR_AI_API_KEY=
# WONDERCREATOR_AI_MODEL=gemini-3.8-flash   # optional override (anthropic default: claude-opus-5)

# Huddle voice/video (optional) — LiveKit
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Protects /api/v1/jobs/run (Vercel Cron sends it as a Bearer token)
CRON_SECRET=
