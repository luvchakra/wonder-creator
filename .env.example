# Copy to apps/web/.env.local. Local values: `npx supabase status -o env`.

# Supabase (public)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Supabase service role — SERVER ONLY (storage registration, intake pipeline, huddle cleanup)
SUPABASE_SECRET_KEY=

# CreatorBrain — Anthropic Claude (server only). Without it: offline dev model (dev) / not connected (prod).
ANTHROPIC_API_KEY=
# WONDER_AI_MODEL=claude-opus-5
# WONDER_AI_PROVIDER=offline   # force the deterministic offline model (dev/CI)

# Huddle voice/video (optional) — LiveKit
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Protects /api/v1/jobs/run (Vercel Cron sends it as a Bearer token)
CRON_SECRET=
