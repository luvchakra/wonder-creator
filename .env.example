# Copy to apps/web/.env.local. Local values: `npx supabase status -o env`.

# Supabase (public)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Supabase service role — SERVER ONLY (storage registration, intake pipeline, huddle cleanup)
SUPABASE_SECRET_KEY=            # or SUPABASE_SERVICE_ROLE_KEY (legacy name)

# CreatorBrain (server only). Provider: gemini | anthropic | offline (deterministic dev/CI model).
# Without a provider + key: offline dev model in development, "not connected" in production.
WONDERCREATOR_AI_PROVIDER=gemini
WONDERCREATOR_AI_API_KEY=
# WONDERCREATOR_AI_MODEL=gemini-3.8-flash   # optional override (anthropic default: claude-opus-5)

# Malware check at intake (optional): SHA-256 reputation lookup only — file contents are never sent.
# WONDERCREATOR_MALWARE_SCAN_PROVIDER=virustotal
# WONDERCREATOR_MALWARE_SCAN_API_KEY=

# Huddle voice/video (optional) — LiveKit
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Protects /api/v1/jobs/run (Vercel Cron sends it as a Bearer token)
CRON_SECRET=

# Contextual image generation (docs/image-generation.md). Server-side only; never exposed to the browser.
# Gemini is the default image provider. Its key is WONDERCREATOR_IMAGE_API_KEY or GEMINI_API_KEY, or the
# CreativeMind key when WONDERCREATOR_AI_PROVIDER=gemini. Without a key, pages say "Image generation isn't connected".
WONDERCREATOR_IMAGE_PROVIDER=gemini
WONDERCREATOR_IMAGE_API_KEY=
# Optional model overrides per quality tier (preview / standard / premium).
WONDERCREATOR_IMAGE_FAST_MODEL=
WONDERCREATOR_IMAGE_DEFAULT_MODEL=
WONDERCREATOR_IMAGE_PREMIUM_MODEL=

# CreatorMarket (P1-18) is architecture only: its API answers 404 unless this is "on". Keep it off until the
# licensing/transaction path is production-ready.
# WONDERCREATOR_FEATURE_MARKET=on

# Royalty-free pictures in the Working Table (optional; Openverse needs no key)
PIXABAY_API_KEY=
PEXELS_API_KEY=

# --- Security & privacy contacts (shown on /legal pages and /.well-known/security.txt; mailto: or https:) ---
# WONDERCREATOR_SECURITY_CONTACT=mailto:security@your-domain.example
# WONDERCREATOR_PRIVACY_CONTACT=mailto:privacy@your-domain.example
# Grievance Officer (India DPDP Act) — name shown on the privacy notice when set.
# WONDERCREATOR_GRIEVANCE_OFFICER=
# Key for signing media links (falls back to one derived from the Supabase secret key).
# WONDERCREATOR_MEDIA_SECRET=
